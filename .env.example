# Copy to .env and fill in. .env is gitignored.

# --- character -------------------------------------------------------------
# Resolve these with: pwsh scripts/discover.ps1 -Name <name> -Region <region>
# Region is one of: nae naw eu la as
AION2_REGION=eu
AION2_SERVER_ID=1302
# NOTE: the characterId arrives percent-encoded from the search endpoint.
# Keep it EXACTLY as discovered, including any %3D suffix. Do not decode it.
AION2_CHARACTER_ID=

# Optional friendly name used in the dashboard title
AION2_CHARACTER_NAME=

# --- fetching --------------------------------------------------------------
# Seconds between HTTP requests. The brief asks for 3-5s. Do not go below 2.
AION2_RATE_LIMIT_SECONDS=4
# Minimum minutes between snapshots of the same character
AION2_SNAPSHOT_COOLDOWN_MINUTES=20
# Hours between automatic scheduled snapshots
SNAPSHOT_INTERVAL_HOURS=6

# --- storage ---------------------------------------------------------------
AION2_DB_PATH=/data/aion2.db

# --- web / mcp -------------------------------------------------------------
AION2_HOST=0.0.0.0
AION2_PORT=8080
# Bearer token for the MCP endpoint. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

TZ=Europe/Bucharest
