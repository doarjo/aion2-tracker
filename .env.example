# Copy to .env and fill in. .env is gitignored.

# --- character -------------------------------------------------------------
# Resolve these with: pwsh scripts/discover.ps1 -Name <name> -Region <region>
# Region is one of: nae naw eu la as
AION2_REGION=eu
AION2_SERVER_ID=1302
# NOTE: the characterId arrives percent-encoded from the search endpoint.
# Keep it EXACTLY as discovered, including any %3D suffix. Do not decode it.
AION2_CHARACTER_ID=

# Optional friendly name used in the dashboard title
AION2_CHARACTER_NAME=

# --- fetching --------------------------------------------------------------
# Seconds between HTTP requests. The brief asks for 3-5s. Do not go below 2.
AION2_RATE_LIMIT_SECONDS=4
# Minimum minutes between snapshots of the same character
AION2_SNAPSHOT_COOLDOWN_MINUTES=20
# Hours between automatic scheduled snapshots
SNAPSHOT_INTERVAL_HOURS=6

# --- storage ---------------------------------------------------------------
AION2_DB_PATH=/data/aion2.db

# --- web / mcp -------------------------------------------------------------
AION2_HOST=0.0.0.0
AION2_PORT=8080
# Bearer token for the MCP endpoint at /mcp.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty ONLY on a trusted LAN: an open /mcp lets anyone trigger a
# refresh against PLAYNC in your name.
MCP_AUTH_TOKEN=

# Hostnames /mcp will answer to, comma separated. The MCP SDK rejects any
# other Host header as DNS rebinding with HTTP 421, which bites behind a
# tunnel presenting its own hostname. localhost and 127.0.0.1 are always
# allowed. Use * to disable the check entirely.
#   MCP_ALLOWED_HOSTS=aion2.23nit.com,192.168.100.30
MCP_ALLOWED_HOSTS=

TZ=Europe/Bucharest
